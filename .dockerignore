# Keep the build context small and free of secrets and local state.
**/node_modules
.git
.github
.claude
.vscode
.idea
.env
.env.*
!.env.example
data/runtime
coverage
dist
*.log
npm-debug.log*

# Not needed by the running app (the Dockerfile copies only src, web, public, data and scripts/lib).
hardhat/*
!hardhat/package.json
!hardhat/package-lock.json
!hardhat/hardhat.config.js
!hardhat/contracts
tests
docs
patches
scripts/vendor
Assign
