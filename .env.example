# AgentBL — environment variables. Copy to .env and fill in what you need.
#
# Everything is OPTIONAL in Demo mode (the default): with no keys the AI valuation
# agent, market data and world-risk intelligence run on deterministic offline fixtures,
# so the demo always works. NEVER commit a real .env; keep every *_KEY / *_TOKEN blank here.

# ---------------------------------------------------------------------------
# 1) Server
# ---------------------------------------------------------------------------
# PORT=3000
# Interface to bind. Unset = all interfaces (Docker sets 0.0.0.0). Use 127.0.0.1 to keep a
# dev server private to this machine.
# HOST=127.0.0.1
# Number of reverse proxies in front of the app (1 for a single nginx/Caddy, or "true").
# Only then is X-Forwarded-For used for per-IP rate limiting; leave unset when exposed directly.
# TRUST_PROXY=1
# Largest accepted JSON request body in bytes (default 1048576 = 1 MiB).
# AGENTBL_MAX_BODY_BYTES=1048576
# Per-client, per-minute request budgets (0 disables). Defaults: 1200 / 300 / 30.
# AGENTBL_RATE_LIMIT_PER_MIN=1200        # every /api request
# AGENTBL_WRITE_RATE_LIMIT_PER_MIN=300   # POST/PUT/PATCH/DELETE
# LLM_RATE_LIMIT_PER_MIN=30              # /api/llm/chat
# Live activity stream (SSE): max concurrent clients and heartbeat interval.
# AGENTBL_MAX_SSE_CLIENTS=200
# AGENTBL_SSE_HEARTBEAT_MS=25000
# Where x402 receipts, cached paid reports, decision logs and Mystery reveals are written
# (default: data/runtime inside the project). Must be writable and persistent in production.
# AGENTBL_RUNTIME_DIR=data/runtime
# Optional folder with on-chain evidence JSON (wave-b-protocol.json, ...) exposed as MCP
# resources. Not shipped in the Docker image; the resources report "not available" without it.
# AGENTBL_EVIDENCE_DIR=docs/evidence

# ---------------------------------------------------------------------------
# 2) Runtime mode and administration
# ---------------------------------------------------------------------------
# Demo is the safe default; Live never silently falls back to mock transactions.
# DEMO_MODE=true
# Secret (at least 16 characters) that authorises switching the runtime mode into or out
# of Live from the UI/API. Without it, mode switching is disabled whenever Live is
# configured. Send it as "Authorization: Bearer <token>" or "X-Admin-Token".
# Generate one with:  openssl rand -hex 24
AGENTBL_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 3) LLM provider for tool calling (pick ONE). OpenAI-compatible /chat/completions.
#    The browser never sees these keys: the dashboard calls the same-origin relay
#    (/api/llm/chat), which adds the key server-side, picks the model, caps max_tokens and
#    rate-limits per client. Still set a spend limit on the provider key.
# ---------------------------------------------------------------------------
# DeepSeek — https://platform.deepseek.com  (model: deepseek-chat)
DEEPSEEK_API_KEY=

# Qwen / 通义千问 via Alibaba DashScope (OpenAI-compatible mode)
# https://dashscope.console.aliyun.com  (model: qwen-plus / qwen-max)
# Ali_API_KEY / Ali_BASE_URL are accepted as aliases of these two.
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tencent Cloud TokenHub / Hunyuan (OpenAI-compatible). The model is locked to
# hy3-preview; when set, this provider wins by default.
Tencent_API_KEY=
Tencent_BASE_URL=https://tokenhub.tencentmaas.com/v1

# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=

# Optional explicit selection / overrides:
# LLM_PROVIDER=tencent             # tencent | deepseek | qwen | openai
# LLM_MODEL=deepseek-chat          # ignored for Tencent
# Fully custom OpenAI-compatible endpoint:
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=
# Relay controls: LLM_PROXY_ENABLED=false turns /api/llm/* off (assistant falls back to
# keyword search); LLM_PROXY_MAX_CONCURRENCY caps simultaneous upstream calls (default 4).
# LLM_PROXY_ENABLED=true
# LLM_PROXY_MAX_CONCURRENCY=4
# Reasoning models (GLM, DeepSeek-R1, ...) think before they answer, and the hidden thinking counts against
# max_tokens: the relay's 2048 cap can end with no answer at all. Raise the cap (256-32768, default 2048), set 0
# for no cap on a free gateway (the 60 s upstream timeout, concurrency and rate limits still apply), and/or
# set an explicit effort (low | medium | high). The effort is only sent when set, because a provider that
# does not know the field may reject it. Measured on one GLM gateway for the dashboard filter prompt: unset
# ~2400 thinking tokens / 28 s, high ~580 / 11 s, low ~65 / 4 s.
# LLM_MAX_TOKENS_CAP=2048
# LLM_REASONING_EFFORT=high

# ---------------------------------------------------------------------------
# 4) Live commodity price (copper, USD/MT). Pick one; else mock.
# ---------------------------------------------------------------------------
# Alpha Vantage (free) — COPPER global monthly price. https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# metalpriceapi.com (freemium) — LME copper real-time. https://metalpriceapi.com
METALPRICE_API_KEY=
# COMMODITY_PRICE_PROVIDER=alphavantage   # metalprice | alphavantage | mock

# Regional physical premium (CIF Shanghai / Yangshan), USD/MT.
# No free API (SMM/Fastmarkets are paid); set the current value manually.
# REGION_PREMIUM_USD_PER_MT=70

# ---------------------------------------------------------------------------
# 5) Historical comparable trade prices (UN Comtrade, by HS code). Free.
# ---------------------------------------------------------------------------
# Register at https://comtradedeveloper.un.org -> subscribe -> "primary key".
COMTRADE_PRIMARY_KEY=

# ---------------------------------------------------------------------------
# 6) xAPI (xapi.to) — live real-world risk signals for the world-risk agent.
#    One key calls Twitter/X, Google News and prediction markets; output is JSON.
#    Used by `npm run intel` and POST /api/intel/world-risk. With NO key, the
#    world-risk agent runs on deterministic offline fixtures (demo always works).
#    Get a key: `npx xapi-to register` (invite code: xapito), then
#    `npx xapi-to oauth bind --provider twitter`. See docs/xapi-integration.md.
# ---------------------------------------------------------------------------
XAPI_KEY=
# XAPI_ACTION_HOST=action.xapi.to   # override the action gateway host (rarely needed)

# ---------------------------------------------------------------------------
# 7) x402 paid intelligence. See docs/x402-integration.md.
#    Demo mode (default) simulates the 402 -> sign -> settle -> unlock flow locally.
#    Live mode settles real USDC through a facilitator (x402 V2, EIP-3009).
#    Live needs all three of: X402_MODE=live, X402_FACILITATOR_URL, X402_PAY_TO.
# ---------------------------------------------------------------------------
# X402_MODE=demo                          # demo | live
# CAIP-2 network: eip155:1439 (Injective EVM testnet) or eip155:1776 (mainnet).
# X402_NETWORK=eip155:1439
# Settlement relay. GET <url>/supported must list scheme "exact" for X402_NETWORK (checked at start-up).
# On 2026-10-12 x402-facilitator.molandak.org listed only Monad networks, so it cannot settle eip155:1439.
# The staging relay below does, but it is plain HTTP: it needs X402_ALLOW_INSECURE_TESTNET=true (testnet only).
# X402_FACILITATOR_URL=http://x402-staging-alb-1300061645.us-east-1.elb.amazonaws.com
# Address that receives the USDC payments (required in live mode, never the zero address).
# X402_PAY_TO=
# Public origin of this server, used in payment requirements when it runs behind a proxy.
# X402_PUBLIC_BASE_URL=https://agentbl.example.com
# (Product prices are fixed in src/x402/config.js: 0.001 / 0.002 / 0.0015 / 0.001 USDC.)
# Validity window of a payment authorization in seconds (10-300, default 60).
# X402_TTL_SECONDS=60
# Paid report cache/envelope TTL in seconds (10-86400, default 300).
# X402_REPORT_TTL_SECONDS=300
# Facilitator request timeout (ms) and bounded retries for transient failures.
# X402_REQUEST_TIMEOUT_MS=10000
# X402_MAX_ATTEMPTS=3
# Milliseconds to wait before retrying a failed live-gateway start-up (default 5000).
# X402_GATEWAY_RETRY_MS=5000
# Testnet-only escape hatch that allows a plain-HTTP facilitator.
# X402_ALLOW_INSECURE_TESTNET=false
# RPC used to read balances / confirm settlement (defaults to INJECTIVE_RPC_URL, then the public node).
# X402_RPC_URL=
# USDC token (must be the canonical USDC of the network; leave unset).
# X402_ASSET=

# Buyer wallet of the CLI/agent client (`npm run x402:intel`, `npm run smoke:x402:live`).
# Signs EIP-3009 payments locally; it is never printed or sent anywhere.
WHITE_AGENT_PRIVATE_KEY=
# Testnet-only live smoke (explicit one-run consent is mandatory):
# X402_LIVE_CONFIRM=injective-testnet
# X402_BUYER_PRIVATE_KEY=
# X402_ALLOW_SELF_PAYMENT=false
# X402_LIVE_AMOUNT_ATOMIC=1000
# X402_RECOVER_PAYMENT_TX=   # resume after a confirmed payment without paying again

# ---------------------------------------------------------------------------
# 8) Blockchain keys. Use a SEPARATE key per role (least privilege).
# ---------------------------------------------------------------------------
# Injective EVM RPC (defaults to the public testnet node).
# INJECTIVE_RPC_URL=https://k8s.testnet.json-rpc.injective.network
# Contract OWNER key: used by `cd hardhat && npm run deploy:*` and by nothing else when
# the two role keys below are set. Keep it off any internet-facing server.
DEPLOYER_PRIVATE_KEY=
# Key the server uses to write PaymentOracle attestations. Authorise it once with
#   PaymentOracle.setAttestor(<address>, true)
PAYMENT_ATTESTOR_PRIVATE_KEY=
# Key the MCP tools use to push prices to RiskPricingOracle. Authorise it once with
#   RiskPricingOracle.setUpdater(<address>, true)
PRICING_UPDATER_PRIVATE_KEY=
# true = never fall back to DEPLOYER_PRIVATE_KEY for the two roles above (recommended in production).
# SIGNER_KEYS_STRICT=true
# Signs Voyage Passport credentials. Unset = a public demo key that holds no funds.
# VOYAGE_PASSPORT_ISSUER_PRIVATE_KEY=
# Recover a PaymentOracle deployment that confirmed after the local RPC disconnected:
# PAYMENT_ORACLE_RECOVERY_ADDRESS=
# PAYMENT_ORACLE_RECOVERY_TX=
# PAYMENT_ORACLE_RECOVERY_CONFIRMED=true   # only after checking the address on the explorer

# ---------------------------------------------------------------------------
# 9) MCP
# ---------------------------------------------------------------------------
# Out-of-band approval token required for MCP tools that broadcast real transactions.
MCP_HUMAN_APPROVAL_TOKEN=

# ---------------------------------------------------------------------------
# 10) Agent runtime (docs/agent-implementation-plan.md)
# ---------------------------------------------------------------------------
# The runtime starts with the server unless this is false (decisions stay readable either way).
# AGENT_ENABLED=true
# off | observe | propose | auto. Demo defaults to auto (simulated execution). In Live the agent only
# PROPOSES: auto is treated as propose and every action waits for a human approval.
# AGENT_AUTONOMY=
# Demo only: let irreversible actions (settle, freeze, liquidate) run without approval. Not recommended.
# AGENT_ALLOW_UNATTENDED_IRREVERSIBLE=false
# On-chain pools that refuse freeze / liquidate / settle / cancel (comma separated). Pool #2 is the
# standing Live demo pool.
# AGENT_PROTECTED_CHAIN_POOLS=2
# Seconds between monitor ticks (minimum 30).
# AGENT_MONITOR_INTERVAL_SEC=300
# A single price move above this many basis points needs approval even in Demo.
# AGENT_MAX_PRICE_MOVE_BPS=1500
# Same action on the same pool inside this window is only recorded; at most this many actions per pool per day.
# AGENT_COOLDOWN_SEC=600
# AGENT_MAX_ACTIONS_PER_POOL_PER_DAY=12
# How long a pending approval stays valid.
# AGENT_APPROVAL_TTL_SEC=86400
# Confirmations to wait for before a Live transaction counts as done.
# AGENT_CHAIN_CONFIRMATIONS=1
# Decision log bounds.
# AGENT_MAX_DECISIONS=5000
# AGENT_RETENTION_DAYS=90
# Consecutive clear world-risk observations before a pool is resumed (stops flapping).
# AGENT_RISK_CLEAR_TICKS=2
# Warn this many days before an insurance policy expires.
# AGENT_INSURANCE_WARN_DAYS=7
# Demo scenario clock speed-up (1 = real time).
# AGENT_SCENARIO_SPEED=1
# Largest single uploaded document, in bytes before base64.
# AGENT_UPLOAD_MAX_BYTES=8388608
# Let the ingest pipeline use the configured LLM for its valuation step (falls back to the deterministic
# path when no LLM is configured or the call fails). Set false to keep ingestion fully offline.
# AGENT_VALUATION_LLM=true
# OPTIONAL. Only if you want the server itself to send markInTransit / recordImporterPayment /
# recordCargoArrival / settle (otherwise an operator signs them with `npm run agent:approve`).
# Fund a fresh address with ~0.01 INJ and have the owner authorise it once with
#   RWAOfferingPool.setAgentExecutor(<address>, true)
# It never falls back to DEPLOYER_PRIVATE_KEY.
AGENT_EXECUTOR_PRIVATE_KEY=
