# Line endings: text files are normalised to LF inside the repository. The working tree
# keeps the platform default (CRLF on Windows with core.autocrlf), so nobody has to
# change a git setting.
* text=auto

# Reproducible source and compiler metadata must use identical bytes on Windows and CI.
*.js text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.sol text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.csv text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Always LF, on every platform: shells, containers, make and CI parse these literally.
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.nvmrc text eol=lf

# Vendored browser bundles are integrity-checked byte for byte (public/vendor/manifest.json
# holds their SHA-256) and must never be converted.
public/vendor/** -text

# Review receipts are hashed as captured; preserve their bytes across platforms.
docs/evidence/** -text
# Source-document fixture hashes must survive checkout without newline conversion.
data/uploads/** -text

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
*.wasm binary
