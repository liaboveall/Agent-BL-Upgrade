{
  "name": "agentbl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Controlled trade-finance blockchain research application with auditable testnet custody and settlement",
  "scripts": {
    "build": "vite build --config web/vite.config.js",
    "predev": "npm run build",
    "dev": "node src/app/server.js",
    "dev:web": "vite --config web/vite.config.js",
    "start": "node src/app/server.js",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "test:browser": "playwright test",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=88 --test-coverage-branches=72 --test-coverage-functions=86 tests/*.test.js",
    "lint": "eslint . --max-warnings=0",
    "check": "node scripts/check.mjs",
    "vendor:check": "node scripts/vendor-frontend.mjs",
    "vendor:build": "node scripts/vendor-frontend.mjs --build",
    "smoke": "node scripts/smoke.mjs",
    "scenarios": "node scripts/scenarios.mjs",
    "price:scenarios": "node scripts/pricing-scenarios.mjs",
    "agent:value": "node scripts/agent-valuation.mjs",
    "price": "node scripts/price.mjs",
    "intel": "node scripts/world-intel.mjs",
    "realdata:snapshot": "node scripts/real-data-snapshot.mjs",
    "mcp": "node scripts/mcp.mjs",
    "mcp:stdio": "node src/mcp/standalone-server.js",
    "smoke:x402": "node scripts/smoke-x402.mjs",
    "smoke:x402:live": "node scripts/live-x402-smoke.mjs",
    "x402:intel": "node scripts/x402-intel.mjs",
    "demo:once": "node scripts/demo-once.mjs",
    "preflight": "node scripts/preflight.mjs",
    "eval:agent": "node scripts/eval-agent.mjs",
    "compile:contracts": "npm --prefix hardhat run compile",
    "test:contracts": "npm --prefix hardhat test",
    "agent:replay": "node scripts/agent-replay.mjs",
    "agent:redteam": "node scripts/agent-redteam.mjs",
    "interop:demo": "node scripts/agent-interop-demo.mjs",
    "agent:verify-anchor": "node scripts/agent-verify-anchor.mjs",
    "agent:anchor-plan": "node scripts/agent-anchor-plan.mjs",
    "test:w2": "node scripts/test-w2.mjs",
    "test:w3": "node scripts/test-w3.mjs",
    "rights:plan": "node scripts/rights-plan.mjs",
    "rights:candidate": "node scripts/prepare-rights-candidate.mjs",
    "test:w4": "node scripts/test-w4.mjs",
    "eval:w4": "node scripts/eval-w4-providers.mjs",
    "evidence:verify": "node scripts/verify-evidence.mjs",
    "evidence:corpus": "node scripts/acquire-w4-corpus.mjs",
    "eval:w4:market": "node scripts/eval-w4-market.mjs",
    "eval:w4:screening": "node scripts/eval-w4-screening.mjs",
    "test:w5": "node scripts/test-w5.mjs",
    "test:n1": "node scripts/test-n1.mjs",
    "runtime:backup": "node scripts/runtime-backup.mjs",
    "load:w5": "node scripts/load-w5.mjs",
    "build:clean": "node scripts/clean-build-w5.mjs",
    "deploy:w5": "node scripts/deploy-w5-testnet.mjs",
    "recover:w5": "node scripts/recover-w5.mjs",
    "validate": "node scripts/validate-w5.mjs",
    "test:n2": "node scripts/test-n2.mjs",
    "terms:verify": "node scripts/verify-financing-terms.mjs",
    "test:n3": "node scripts/test-n3.mjs",
    "test:n3:evm": "node scripts/test-n3-evm.mjs",
    "test:n4": "node scripts/test-n4.mjs",
    "test:n5": "node scripts/test-n5.mjs",
    "inspect:n5": "node scripts/inspect-n5.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "ai-agent",
    "blockchain",
    "trade-finance",
    "electronic-bill-of-lading",
    "rwa"
  ],
  "license": "MIT",
  "dependencies": {
    "@injectivelabs/x402": "0.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "unpdf": "1.7.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2"
  }
}
