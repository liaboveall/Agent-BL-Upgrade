{
  "name": "agentbl-agent-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hackathon harness for an AI dynamic pricing eBL-backed RWA trade finance protocol.",
  "scripts": {
    "postinstall": "node scripts/install.mjs || echo 'Skipping postinstall'",
    "build": "vite build --config web/vite.config.js",
    "predev": "npm run build",
    "dev": "node src/app/server.js",
    "dev:web": "vite --config web/vite.config.js",
    "start": "node src/app/server.js",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "test:browser": "playwright test",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=88 --test-coverage-branches=72 --test-coverage-functions=86 tests/*.test.js",
    "lint": "eslint . --max-warnings=0",
    "check": "node scripts/check.mjs",
    "vendor:check": "node scripts/vendor-frontend.mjs",
    "vendor:build": "node scripts/vendor-frontend.mjs --build",
    "smoke": "node scripts/smoke.mjs",
    "scenarios": "node scripts/scenarios.mjs",
    "price:scenarios": "node scripts/pricing-scenarios.mjs",
    "agent:value": "node scripts/agent-valuation.mjs",
    "price": "node scripts/price.mjs",
    "intel": "node scripts/world-intel.mjs",
    "realdata:snapshot": "node scripts/real-data-snapshot.mjs",
    "mcp": "node scripts/mcp.mjs",
    "mcp:stdio": "node src/mcp/standalone-server.js",
    "smoke:x402": "node scripts/smoke-x402.mjs",
    "smoke:x402:live": "node scripts/live-x402-smoke.mjs",
    "x402:intel": "node scripts/x402-intel.mjs",
    "demo:once": "node scripts/demo-once.mjs",
    "preflight": "node scripts/preflight.mjs",
    "eval:agent": "node scripts/eval-agent.mjs",
    "compile:contracts": "npm --prefix hardhat run compile",
    "test:contracts": "npm --prefix hardhat test",
    "deploy:protocol": "npm --prefix hardhat run deploy:protocol",
    "verify:bytecode": "node scripts/verify-bytecode.mjs",
    "verify:wave-b": "node scripts/wave-b-gate.mjs",
    "agent:approve": "node scripts/agent-approve.mjs",
    "smoke:mcp:injective": "node scripts/injective-mcp-smoke.mjs",
    "migrate:chain-config": "node scripts/migrate-chain-config.mjs",
    "spike:bank": "node scripts/injective-bank-precompile.mjs",
    "spike:bank:live": "node scripts/injective-bank-precompile.mjs --live",
    "spike:exchange": "node scripts/injective-exchange-precompile.mjs",
    "spike:exchange:live": "node scripts/injective-exchange-precompile.mjs --live",
    "agent:replay": "node scripts/agent-replay.mjs",
    "agent:redteam": "node scripts/agent-redteam.mjs",
    "agent:smoke": "node scripts/agent-live-smoke.mjs",
    "interop:demo": "node scripts/agent-interop-demo.mjs",
    "agent:verify-anchor": "node scripts/agent-verify-anchor.mjs",
    "agent:anchor-plan": "node scripts/agent-anchor-plan.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "hackathon",
    "ai-agent",
    "blockchain",
    "trade-finance",
    "electronic-bill-of-lading",
    "rwa"
  ],
  "license": "MIT",
  "dependencies": {
    "@injectivelabs/x402": "0.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "unpdf": "1.7.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2"
  }
}
