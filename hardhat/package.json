{
  "name": "agentbl-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Hardhat contracts for AgentBL eBL-backed RWA offering (WEB3-6 ~ WEB3-9).",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "compile": "hardhat build",
    "test": "hardhat test",
    "deploy:injective": "hardhat run scripts/deploy-agentbl.js --network injective_testnet",
    "deploy:payment-oracle": "hardhat run scripts/deploy-payment-oracle.js --network injective_testnet",
    "deploy:protocol": "hardhat run scripts/deploy-protocol.js --network injective_testnet",
    "deploy:all": "npm run deploy:protocol && npm run deploy:payment-oracle",
    "deploy:agent-log": "hardhat run scripts/deploy-agent-log.js --network injective_testnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.12",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "chai": "^6.3.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "hardhat": "^3.19.0",
    "mocha": "^12.0.3"
  },
  "allowScripts": {
    "esbuild": false
  }
}
